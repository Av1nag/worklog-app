# Copy to .env and fill in.

# Postgres connection string.
DATABASE_URL=postgres://user:password@localhost:5432/worklog

# Set to "true" when the DB requires SSL (most managed providers).
DATABASE_SSL=false

# Long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# "production" enables the Secure cookie flag (requires HTTPS).
NODE_ENV=development

PORT=3000
