# Copy to .env and fill in.

# Postgres connection string.
DATABASE_URL=postgres://user:password@localhost:5432/worklog

# Set to "true" when the DB requires SSL (most managed providers).
DATABASE_SSL=false

# Long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# "production" enables the Secure cookie flag (requires HTTPS).
NODE_ENV=development

PORT=3000

# Brevo (brevo.com) transactional email — free tier, 300 emails/day.
# API key: Brevo dashboard > SMTP & API > API Keys.
BREVO_API_KEY=

# Sender address. Must be a verified sender/domain in Brevo.
EMAIL_FROM=noreply@example.com

# Base URL used to build the verification link sent by email.
# Defaults to the request's own protocol+host if unset, which is fine for a
# single-domain deploy behind Caddy; set explicitly if that ever differs.
APP_URL=
